                      "code": "// @ts-nocheck\nexport const code = async (inputs) => {\n  const p = inputs.b || {}; const now = new Date().toISOString();\n  const cols = [\"Agreement_ID\", \"Created_At\", \"Tenant_Name\", \"Tenant_GSTIN\", \"Tenant_State\", \"Centre\", \"Unit\", \"Agreement_Type\", \"Start_Date\", \"End_Date\", \"Monthly_Amount\", \"GST_Rate\", \"GST_Type\", \"GST_Amount\", \"Monthly_Total\", \"Due_Day\", \"Next_Due_Date\", \"Tenant_Ledger\", \"Income_Head\", \"Invoice_Status\", \"Status\"]; const map = {}; const only = [\"Invoice_Status\"]; const fill = {\"Invoice_Status\": \"Raised\"};\n  const src = { ...p }; for (const [k, c] of Object.entries(map)) if (p[k] !== undefined) src[c] = p[k];\n  const patch = {}; for (const [k, v] of Object.entries(src)) { if (!cols.includes(k) || k === 'Agreement_ID' || v === undefined || v === null) continue; if (only && (String(v) === '' || !only.includes(k))) continue; patch[k] = v; }\n  for (const [k, v] of Object.entries(fill)) patch[k] = v === 'now' ? now : v;\n  return { patch, id: String(p['Agreement_ID'] || '') };\n};",
