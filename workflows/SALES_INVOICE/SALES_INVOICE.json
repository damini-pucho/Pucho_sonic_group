                  "code": "// @ts-nocheck\nexport const code = async (inputs) => { const p = inputs.b || {}; const now = new Date().toISOString(); const allowed = [\"Invoice_ID\", \"Prepared_At\", \"Agreement_ID\", \"Tenant_Name\", \"Tenant_State\", \"Centre\", \"Period\", \"Due_Date\", \"Taxable_Value\", \"GST_Rate\", \"GST_Type\", \"GST_Amount\", \"Total_Amount\", \"Tenant_Ledger\", \"Income_Head\", \"Narration\", \"Status\", \"Exported_At\"]; const map = {\"Next_Due_Date\": \"Due_Date\", \"Monthly_Amount\": \"Taxable_Value\", \"Monthly_Total\": \"Total_Amount\"}; const fill = {\"Status\": \"Prepared\", \"Prepared_At\": \"now\"};\n  const src = { ...p }; for (const [k, c] of Object.entries(map)) if (p[k] !== undefined) src[c] = p[k];\n  const row = {}; for (const k of allowed) row[k] = src[k] === undefined ? '' : src[k]; for (const [k, v] of Object.entries(fill)) row[k] = v === 'now' ? now : v;\n  if (!row['Prepared_At']) row['Prepared_At'] = now;\n  return { row };\n};",
